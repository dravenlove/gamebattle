{erl_opts, [debug_info, warn_unused_vars, warn_missing_spec]}.
{src_dirs, ["src"]}.

%% Client protocol: src/battle_client_pb.erl is generated from
%% ../proto/battle_client.proto before every compile and is not committed.
%% The generated module has no run-time dependency on gpb. Compiling it prints
%% 9 missing-spec warnings: gpb writes no specs for decode_msg/2 and a few
%% others, and warn_missing_spec above cannot be turned off for one file.
{plugins, [{rebar3_gpb_plugin, "3.0.1"}]}.
{gpb_opts, [
    {i, "../proto"},
    {o_erl, "src"},
    %% No .hrl is written with the maps option, but the directory must exist
    %% (the default, include/, does not).
    {o_hrl, "src"},
    {module_name_suffix, "_pb"},
    maps,
    {maps_unset_optional, omitted},
    {strings_as_binaries, true},
    type_specs,
    %% Reject bad values while encoding instead of sending corrupt bytes.
    {verify, always},
    %% get_msg_defs/0 and friends: not needed, and they have no specs.
    {gen_introspect, false}
]}.
{provider_hooks, [
    {pre, [
        {compile, {protobuf, compile}},
        {clean, {protobuf, clean}}
    ]}
]}.

%% eunit: run the modules in test/ only. Scanning src/ as well would load
%% gamebattle_nif, whose on_load fails unless the NIF library has been built.
%% Test functions need no specs.
{eunit_tests, [{dir, "test"}]}.
{profiles, [
    {test, [{erl_opts, [nowarn_missing_spec]}]}
]}.
